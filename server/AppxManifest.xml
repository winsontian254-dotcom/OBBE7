<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/manifest/map/2014"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/rescapabilities/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="mp rescap uap">

  <Identity
    Name="XR5FEHostServer"
    Publisher="CN=XR5FE"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>XR5FE Host Server</DisplayName>
    <PublisherDisplayName>XR5FE (A fork of AR3Te)</PublisherDisplayName>
    <Logo>Assets\logo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.Desktop" 
      MinVersion="14.0.0.0" 
      Publisher="CN=Microsoft Corporation" />
    <PackageDependency Name="Microsoft.NETCore.DesktopRuntime.8.0" 
      MinVersion="8.0.0.0" 
      Publisher="CN=Microsoft Corporation" />
    <PackageDependency Name="Microsoft.UI.Xaml.2.8" 
      MinVersion="8.0.0.0" 
      Publisher="CN=Microsoft Corporation" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="XR5FEHostServer"
      Executable="XR5FEHostServer.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="XR5FE Host Server"
        Description="Screen streaming server for XR5FE Android app (a fork of AR3Te)"
        BackgroundColor="#4CAF50"
        Square150x150Logo="Assets\logo.png"
        Square44x44Logo="Assets\logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\logo.png" />
      </uap:VisualElements>
      <Extensions>
        <rescap:Extension Category="windows.fullTrustProcess" Executable="XR5FEHostServer.exe" />
        <rescap:Extension Category="windows.desktopAppMigration">
          <rescap:DesktopAppMigration>
            <rescap:DesktopApp Shortcut="%STARTMENU%\XR5FE Host Server.lnk">
              <rescap:DesktopApp.TargetPath>XR5FEHostServer.exe</rescap:DesktopApp.TargetPath>
            </rescap:DesktopApp>
          </rescap:DesktopAppMigration>
        </rescap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>

</Package>
